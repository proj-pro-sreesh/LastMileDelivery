ENVIRONMENT=development

# PostgreSQL connection string.
# TCP example:      postgresql+psycopg://postgres:postgres@localhost:5432/lastmile_delivery
# Local socket example (macOS Homebrew): postgresql+psycopg:///lastmile_delivery
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/lastmile_delivery

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Notification delivery mode: "mock" logs email/SMS to stdout; "disabled" turns everything off
NOTIFICATIONS_MODE=mock

# Outbound email provider: "mock" (default) or "resend" (https://resend.com)
EMAIL_PROVIDER=mock
EMAIL_API_KEY=
EMAIL_FROM=

# Outbound SMS provider: "mock" (default) or "twilio"
# For twilio, SMS_API_KEY must be "AccountSid:AuthToken" and SMS_FROM a Twilio sender number
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_FROM=
